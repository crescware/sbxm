cause-sandbox-workspace-not-empty = the directory holds entries that were not accounted for
cause-larger-than = the source is { $observed } bytes, and sbxm places at most { $maximum }
cause-not-valid-utf8 = the destination is not valid UTF-8
cause-leaves-agent-home = the destination leaves the agent home directory
cause-symbolic-link-in-sandbox = { $observed } is a symbolic link inside the sandbox
cause-not-bare-repository = the repository is not bare, so it is not the shared repository
